---
// Wordmark + the phosphor mark: the plane climbing inside its usage ring,
// rendered as a matrix of terminal glyphs. Same master as the app icon —
// one mark everywhere.
interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-2.5" aria-label="llmpilot home">
  <img src="/brand/icon-128.png" alt="" width="26" height="26" class="rounded-md" aria-hidden="true" />
  <span class="text-[17px] font-semibold tracking-tight text-text">llmpilot</span>
</a>
