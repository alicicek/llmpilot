---
// Wordmark + the charge-block glyph (the product's one gradient lives inside
// the app; here the glyph is a flat accent block — a reset is the trailing
// edge of a 5-hour object).
interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---

<a href={href} class="inline-flex items-center gap-2.5" aria-label="llmpilot home">
  <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
    <rect x="5" y="23" width="54" height="19" rx="7" fill="var(--primary)"></rect>
  </svg>
  <span class="text-[17px] font-semibold tracking-tight text-text">llmpilot</span>
</a>
