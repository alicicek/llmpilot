---
import Layout from "../layouts/Layout.astro";
import Brandmark from "../components/Brandmark.astro";
import CtaButton from "../components/CtaButton.astro";

// Recovery-email link target (?token=…). A browser can't reach the local
// daemon, and /v1/recover/claim requires the daemon-supplied install_id — so
// this page never calls the worker. Primary path (owner 2026-08-29): the
// "Open llmpilot" button hands the token to the app via llmpilot://recover
// and the app finishes the claim itself. The visible code stays as the
// fallback for a link opened on a phone or a Mac without the app.
---

<Layout
  title="llmpilot — restore Pro"
  description="Open llmpilot from this link to restore Pro on this Mac, or use the one-time code."
  noindex
>
  <header class="hdr">
    <Brandmark />
  </header>
  <main class="wrap">
    <p class="eyebrow">recovery — restore Pro</p>

    <div id="has-token" hidden>
      <h1>One step left.</h1>
      <p class="sub">
        On the Mac you're restoring, this button finishes it — llmpilot opens
        and Pro turns on.
      </p>
      <div class="cta">
        <!-- CtaButton's primary/lg grammar verbatim — a plain anchor so the
             script can set the deep-link href from the token. -->
        <a
          id="open-app"
          href="#"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2 select-none bg-primary text-primary-foreground hover:brightness-110 active:brightness-95 h-12 px-6 text-[15px]"
          >Open llmpilot</a
        >
      </div>
      <p class="sub fallback-lead">
        Reading this somewhere else — a phone, or a Mac without llmpilot? Use
        the code instead: copy it, then paste it into llmpilot under
        Settings → License → Restore with code.
      </p>
      <div class="code-box">
        <code id="token"></code>
        <button type="button" class="copy-btn" id="copy" aria-label="Copy recovery code">
          Copy code
        </button>
      </div>
      <p class="fine">
        Button or code, it works once and expires 15 minutes after the email
        was sent. If it has expired, request a fresh one from Restore by
        email in the app.
      </p>
    </div>

    <div id="no-token" hidden>
      <h1>This link is missing its code.</h1>
      <p class="sub">
        Open the link from your recovery email again — everything after
        token= is the code. Or request a fresh email in llmpilot: Settings →
        License → Restore by email.
      </p>
      <div class="cta">
        <CtaButton href="/" variant="quiet" size="lg">Back to llmpilot</CtaButton>
      </div>
    </div>

    <noscript>
      <h1>Your code is in the address bar.</h1>
      <p class="sub">
        JavaScript is off, so this page can't read the code from the link —
        it's everything after token= in the address bar. Paste it into
        llmpilot: Settings → License → Restore with code.
      </p>
    </noscript>
  </main>

  <script>
    const raw = (
      new URLSearchParams(window.location.search).get("token") ?? ""
    ).trim();
    // Only render a token that IS one (32-byte hex): the value is
    // attacker-suppliable via the URL, so an arbitrary string must never be
    // shown as "your restore code" on the real domain.
    const token = /^[0-9a-f]{64}$/i.test(raw) ? raw.toLowerCase() : "";
    const hasToken = document.getElementById("has-token");
    const noToken = document.getElementById("no-token");
    const code = document.getElementById("token");
    if (token && hasToken && code) {
      code.textContent = token;
      hasToken.hidden = false;
      // The app's deep link — the URL scheme carries the token verbatim;
      // the app re-validates its shape before anything reaches the wire.
      const open = document.getElementById("open-app");
      if (open instanceof HTMLAnchorElement) {
        open.href = `llmpilot://recover?token=${encodeURIComponent(token)}`;
      }
    } else if (noToken) {
      noToken.hidden = false;
    }

    const btn = document.getElementById("copy");
    let timer: ReturnType<typeof setTimeout> | undefined;
    btn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(token);
        btn.textContent = "Copied";
        clearTimeout(timer);
        timer = setTimeout(() => (btn.textContent = "Copy code"), 1600);
      } catch {
        /* clipboard blocked — the code is visible to select by hand */
      }
    });
  </script>

  <style>
    .hdr {
      max-width: 1200px;
      margin: 0 auto;
      padding: 14px 24px;
    }
    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: clamp(80px, 18vh, 200px) 24px;
    }
    h1 {
      margin: 18px 0 0;
      font-size: var(--fs-hero);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .sub {
      margin: 18px 0 0;
      max-width: 44ch;
      font-size: var(--fs-sub);
      color: var(--sec);
    }
    .cta {
      margin: 26px 0 0;
    }
    .fallback-lead {
      margin-top: 34px;
      font-size: 14px;
    }
    .code-box {
      display: flex;
      align-items: stretch;
      max-width: 640px;
      margin: 26px 0 0;
      overflow: hidden;
      border: 1px solid var(--hair);
      border-radius: var(--r-md);
      background: var(--panel);
    }
    .code-box code {
      flex: 1;
      padding: 12px 14px;
      font-size: 14px;
      word-break: break-all;
      font-variant-numeric: tabular-nums;
      color: var(--text);
    }
    .copy-btn {
      border: 0;
      border-left: 1px solid var(--hair);
      background: none;
      padding: 0 14px;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      color: var(--acc-tx);
      cursor: pointer;
      transition: background-color 150ms;
    }
    .copy-btn:hover {
      background: rgba(255, 255, 255, 0.05);
    }
    .steps {
      max-width: 52ch;
      margin: 26px 0 0;
      padding-left: 22px;
      list-style: decimal; /* Tailwind preflight strips list markers */
      font-size: var(--fs-body);
      color: var(--sec);
    }
    .steps li::marker {
      font-variant-numeric: tabular-nums;
      color: var(--ter);
    }
    .steps li {
      margin: 6px 0 0;
    }
    .fine {
      max-width: 52ch;
      margin: 22px 0 0;
      font-size: 12px;
      color: var(--ter);
    }
    .cta {
      margin: 30px 0 0;
    }
  </style>
</Layout>
