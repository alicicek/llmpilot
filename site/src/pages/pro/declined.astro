---
import Layout from "../../layouts/Layout.astro";
import Brandmark from "../../components/Brandmark.astro";
import CtaButton from "../../components/CtaButton.astro";

// Where the hosted checkout's back arrow lands (1.3.4): the cancel_url on
// api.llmpilot.dev records the back-out against its cancel token AND expires
// the declined session, then 302s here. The pointer line sends the buyer
// back to the app — worded as an invitation, not a promise: whether the
// win-back offer shows is the app's conditional call (armed-not-spent,
// lower amount exists in their currency — money review 2026-08-27 F10), and
// no price appears on the web (owner decision 2026-08-27).
---

<Layout
  title="llmpilot — checkout cancelled"
  description="Checkout closed before payment — nothing was charged."
  noindex
>
  <header class="hdr">
    <Brandmark />
  </header>
  <main class="wrap">
    <p class="eyebrow">checkout — cancelled</p>
    <h1>Nothing was charged.</h1>
    <p class="sub">
      Checkout closed before payment. Switch back to llmpilot to finish or
      start again — the free core keeps working either way.
    </p>
    <div class="cta">
      <CtaButton href="/" variant="quiet" size="lg">Back to llmpilot</CtaButton>
    </div>
  </main>

  <style>
    .hdr {
      max-width: 1200px;
      margin: 0 auto;
      padding: 14px 24px;
    }
    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: clamp(80px, 18vh, 200px) 24px;
    }
    h1 {
      margin: 18px 0 0;
      font-size: var(--fs-hero);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .sub {
      margin: 18px 0 0;
      max-width: 44ch;
      font-size: var(--fs-sub);
      color: var(--sec);
    }
    .cta {
      margin: 30px 0 0;
    }
  </style>
</Layout>
