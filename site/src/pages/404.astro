---
import Layout from "../layouts/Layout.astro";
import Brandmark from "../components/Brandmark.astro";
import CtaButton from "../components/CtaButton.astro";
---

<Layout title="llmpilot — no window here">
  <header class="hdr">
    <Brandmark />
  </header>
  <main class="wrap">
    <p class="eyebrow">404 — off the timeline</p>
    <h1>No window here.</h1>
    <p class="sub">
      The link led to a time that isn't booked. Head back to the timeline.
    </p>
    <div class="cta"><CtaButton href="/" size="lg">Back to llmpilot</CtaButton></div>
  </main>

  <style>
    .hdr {
      max-width: 1200px;
      margin: 0 auto;
      padding: 14px 24px;
    }
    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: clamp(80px, 18vh, 200px) 24px;
    }
    h1 {
      margin: 18px 0 0;
      font-size: var(--fs-hero);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .sub {
      margin: 18px 0 0;
      max-width: 44ch;
      font-size: var(--fs-sub);
      color: var(--sec);
    }
    .cta {
      margin: 30px 0 0;
    }
  </style>
</Layout>
